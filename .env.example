# ── Frontend (Vercel) ─────────────────────────────────────────────────────
# Not needed if you use the vercel.json rewrite approach (recommended).
# Only set this if you want the frontend to call the backend URL directly.
# VITE_API_BASE_URL=https://bim-backend.railway.app

# ── Backend (Railway) ─────────────────────────────────────────────────────
# Set ALL of these in Railway's environment variable dashboard.

# Port — Railway injects this automatically, leave blank here
# PORT=8080

# Where JSON data files are stored inside the container
DATA_DIR=/data

# Admin account credentials (REQUIRED in production)
ADMIN_EMAIL=your-email@example.com
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=your-strong-password

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=https://favour-bim.vercel.app
